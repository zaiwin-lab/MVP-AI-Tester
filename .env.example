# ─────────────────────────────────────────────────────────────
# KAPT Digital Clinic — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# The app runs fully without any of these set (demo mode), but
# email delivery and AI-assist are disabled until configured.
# ─────────────────────────────────────────────────────────────

# --- Admin authentication ---------------------------------------------------
# Session cookies are signed with this secret. Use a long random string.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Seed admin account (created on first run if no users exist).
# Password is hashed with scrypt at rest — this env value is only the seed.
ADMIN_EMAIL=admin@kobis.example
ADMIN_PASSWORD=changeme-admin-2026
ADMIN_NAME=KAPT Administrator

# --- Email (SMTP via nodemailer) --------------------------------------------
# Leave unset to run in "log" mode: emails are recorded in the case timeline
# and printed to the server console instead of being delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KAPT Digital Clinic <no-reply@kobis.example>"
MAIL_INTERNAL_TO=cap-team@kobis.example

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=15
MAX_UPLOAD_FILES=6

# --- Bot / spam protection --------------------------------------------------
# Optional Cloudflare Turnstile. Leave blank to use the built-in
# honeypot + timing + rate-limit protection only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional internal AI assist (Claude) -----------------------------------
# Used ONLY by the internal diagnosis draft tool. Never exposed to the public.
# If unset, the AI-assist button falls back to a structured template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
